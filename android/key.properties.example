# Copy this file to android/key.properties and fill in your own keystore.
# key.properties is gitignored - never commit your real signing credentials.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore ~/open-hearables-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Without this file, release builds fall back to the debug key and cannot be
# uploaded to Google Play.

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=/absolute/path/to/open-hearables-upload.jks
